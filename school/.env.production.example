# GPU 算力平台 - Production 環境變數範本
# 複製為 .env.production 並填入正式值（請勿 commit .env.production）
#
# 使用方式：
#   cp .env.production.example .env.production
#   vim .env.production
#   docker-compose -f docker-compose.prod.yml up -d --build

# ===== PostgreSQL =====
# Container 內 backend 會用 POSTGRES_HOST=postgres（service name），
# docker-compose.prod.yml 會強制覆寫，不用在這裡設
POSTGRES_USER=gpu_platform
POSTGRES_PASSWORD=PLEASE_CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=gpu_platform

# ===== Backend =====
BACKEND_PORT=4000
JWT_SECRET=PLEASE_CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ===== OpenNebula FireEdge =====
OPENNEBULA_URL=http://10.1.1.79:2616
OPENNEBULA_USER=oneadmin
OPENNEBULA_PASS=PLEASE_FILL_REAL_PASSWORD

# ===== Frontend =====
# Production 由 nginx 反向代理 /api → backend，前端用相對路徑即可，留空
VITE_BACKEND_URL=

# ===== Email（選填）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
