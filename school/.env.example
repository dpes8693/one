# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gpu_platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gpu_platform

# Backend
BACKEND_PORT=4000
JWT_SECRET=change-this-to-random-secret

# OpenNebula FireEdge
OPENNEBULA_URL=http://10.1.1.79:2616
OPENNEBULA_USER=oneadmin
OPENNEBULA_PASS=changeme

# Frontend
VITE_BACKEND_URL=http://localhost:4000

# Email / SMTP（通知用，選填）
# - 留空 SMTP_HOST → 走 console fallback（不真寄信，仍寫 email_notifications DB）
# - 填上 SMTP_HOST → 用 nodemailer 真寄信
# SMTP_SECURE: true = TLS（通常 port 465）；false = STARTTLS / 明文（通常 port 587）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=changeme
SMTP_FROM=noreply@example.com
